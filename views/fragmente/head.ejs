    <link rel="stylesheet" href="/resurse/styles/styles.css"> <!-- Calea către al doilea fișier CSS -->


    <style>
        /* Galerie Grid */
        .galerie-statica {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          grid-template-rows: repeat(5, auto);
          gap: 15px;
          width: 100%;
          max-width: 1200px;
          margin: 0 auto;
          padding: 20px;
          background-color: #f5f5f5;
          margin-top:100px;
          margin-bottom:250px;
        }
      
        .galerie-item {
          position: relative;
          margin: 0;
          overflow: hidden;
          border-radius: 8px;
          box-shadow: 0 4px 8px rgba(0,0,0,0.1);
          transition: all 0.3s ease;
          height: 100%;
        }
      
          .galerie-item img {
          width: 100%;
          height: 200px;
          object-fit: cover;
          display: block;
          transition: all 0.125s ease; /* Adaugă tranziția */
          transform-origin: top center; /* Punctul de scalare */
        }
      
        .galerie-item figcaption {
          padding: 10px;
          background: rgba(0,0,0,0.7);
          color: white;
          position: absolute;
          bottom: 0;
          left: 0;
          right: 0;
          transform: translateY(100%);
          transition: transform 0.25s ease;
        }
      
        .galerie-item:hover {
          transform: scale(1.05);
          box-shadow: 0 8px 16px rgba(0,0,0,0.2);
        }
      
        .galerie-item:hover figcaption {
          transform: translateY(0);
        }
      
        /* Hover pe imagine */
        .galerie-item:hover img {
          transform: scale(1.4);     /* Scalare 40% */
          opacity: 0.5;              /* Semi-transparent */
          border-radius: 15px;       /* Colțuri mai rotunjite */
        }
      
        .index-roman {
          font-weight: bold;
          margin-right: 5px;
        }

                /* Stiluri pentru formular */
        .form-container {
          max-width: 800px;
          margin: 30px auto;
          padding: 25px;
          background: white;
          border-radius: 12px;
          box-shadow: 0 5px 15px rgba(0,0,0,0.1);
          text-align: center;
        }

        .form-group {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          align-items: center;
          gap: 15px;
          margin-bottom: 20px;
        }

        .form-group label {
          font-size: 1.1rem;
          font-weight: 600;
          color: #2c3e50;
        }

        .form-group select {
          padding: 12px 20px;
          border: 2px solid #0c4e7a;
          border-radius: 8px;
          background-color: white;
          font-size: 1rem;
          color: #023261;
          cursor: pointer;
          transition: all 0.3s ease;
          appearance: none;
          background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%233498db'%3e%3cpath d='M7 10l5 5 5-5z'/%3e%3c/svg%3e");
          background-repeat: no-repeat;
          background-position: right 15px center;
          background-size: 20px;
          min-width: 200px;
        }

        .form-group select:focus {
          outline: none;
          border-color: #2980b9;
          box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.3);
        }

        .form-group button {
          padding: 12px 30px;
          background: linear-gradient(135deg, #3498db, #2980b9);
          color: white;
          border: none;
          border-radius: 8px;
          font-size: 1rem;
          font-weight: 600;
          cursor: pointer;
          transition: all 0.3s ease;
          box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .form-group button:hover {
          background: linear-gradient(135deg, #2980b9, #3498db);
          transform: translateY(-2px);
          box-shadow: 0 6px 12px rgba(0,0,0,0.15);
        }

        .form-group button:active {
          transform: translateY(0);
        }


        .main-content {
          min-height: calc(100vh - 200px); /* Ajustează în funcție de înălțimea header/footer */
          padding: 20px 0;
        }

        body {
            background: linear-gradient(135deg, 
            var(--culoare-principala) 0%,         /* Albastru închis */
            var(--border-color) 50%,              /* Auriu (border-color) */
            var(--culoare-background) 100%);      /* Alb */
            color: var(--culoare-text);              /* Textul va fi de culoare închisă pentru contrast */
            font-family: 'Montserrat', sans-serif;   /* Fontul ales pentru site */
            line-height: 1.6;                        /* Îmbunătățirea lizibilității */
            margin: 0;
            padding: 0;
        }

        /* Stilizare pentru titluri */
        h1, h2, h3, h4, h5, h6 {
            color: var(--culoare-text-light);       /* Titlurile vor fi deschise pentru contrast */
        }

        /* Linkurile vor fi stilizate elegant */
        a {
            color: var(--culoare-link-neschimbat);  /* Culoare pentru linkuri */
            text-decoration: none;
            transition: color 0.3s ease, transform 0.3s ease;
        }

        /* Efect de hover pentru linkuri */
        a:hover {
            color: var(--culoare-hover);            /* Culoare linkuri la hover */
            transform: scale(1.05);                 /* Mică animație la hover */
        }

        /* Stilizăm header-ul și footer-ul */
        footer, header {
            background-color: var(--content-bg);   /* Folosim culoarea de fundal pentru header și footer */
            color: var(--culoare-text-light);
            padding: 20px;
            text-align: center;
            box-shadow: var(--box-shadow);           /* Umbra subtilă pentru header și footer */
        }

        /* Adăugăm un border subtil pe anumite elemente */
        .card {
            background-color: var(--culoare-background);
            border: var(--border-width) solid var(--border-color); /* Bordura auriu pentru un aspect elegant */
            border-radius: var(--border-radius);                    /* Colțuri rotunjite */
            box-shadow: var(--box-shadow);                           /* Umbră subtilă pentru carduri */
            padding: 20px;
            margin: 20px 0;
        }


        /* Efecte speciale pentru buton */
        @keyframes pulse {
          0% { transform: scale(1); }
          50% { transform: scale(1.05); }
          100% { transform: scale(1); }
        }

        .form-group button:hover {
          animation: pulse 1.5s infinite;
        }
      
        /* Responsive */
        @media (max-width: 900px) {
          .galerie-statica {
            grid-template-columns: repeat(2, 1fr);
          }
        }
        
      
        @media (max-width: 600px) {
          .galerie-statica {
            grid-template-columns: 1fr !important;
          }
        }
      </style>

